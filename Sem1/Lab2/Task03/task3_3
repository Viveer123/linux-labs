#!/bin/bash
# task3_4 — интерактивный запуск N реальных терминалов
# Количество терминалов = количество голов в команде
# Автор: AnnaNikanorova
# Дата: 2026-10-07

echo "=== task3_4: запуск нескольких терминалов ==="
echo ""

read -p "Сколько голов в команде (2-10)? " NUM

if ! [[ "$NUM" =~ ^[0-9]+$ ]] || [ "$NUM" -lt 2 ] || [ "$NUM" -gt 10 ]; then
    echo "Ошибка: нужно число от 2 до 10."
    exit 1
fi

# Ищем доступный Linux-терминал
TERM_CMD=""
for cmd in gnome-terminal xfce4-terminal konsole xterm x-terminal-emulator; do
    if command -v "$cmd" &>/dev/null; then
        TERM_CMD="$cmd"
        break
    fi
done

echo ""
if [[ -n "$TERM_CMD" ]]; then
    echo "Использую: $TERM_CMD"
else
    echo "Linux-терминал не найден, использую cmd.exe (Windows)."
fi
echo "Запускаю $NUM терминал(ов)..."
echo ""

for i in $(seq 1 "$NUM"); do
    MSG="echo '======================================'; echo '      Терминал #$i'; echo '======================================'; echo 'Пользователь: $(whoami)'; echo 'Директория: $(pwd)'; echo 'Дата: $(date)'; echo ''; echo 'Нажми Enter, чтобы закрыть этот терминал.'; read"

    if [[ -n "$TERM_CMD" ]]; then
        case "$TERM_CMD" in
            gnome-terminal)
                gnome-terminal --title="Терминал #$i" -- bash -c "$MSG; exit"
                ;;
            xfce4-terminal)
                xfce4-terminal --title="Терминал #$i" --command="bash -c \"$MSG; exit\""
                ;;
            konsole)
                konsole --title "Терминал #$i" -e bash -c "$MSG; exit"
                ;;
            xterm|x-terminal-emulator)
                $TERM_CMD -title "Терминал #$i" -e bash -c "$MSG; exit"
                ;;
        esac
    else
        cmd.exe /c start "Терминал #$i" wsl.exe bash -c "$MSG"
    fi

    echo "  → терминал #$i запущен"
done

echo ""
echo "Все $NUM терминал(ов) запущены."
