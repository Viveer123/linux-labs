#!/bin/bash
# task3_4 — интерактивный запуск N терминалов через cmd.exe (Windows)

echo ""
read -p "Сколько голов в команде (2-10)? " NUM

if ! [[ "$NUM" =~ ^[0-9]+$ ]] || [ "$NUM" -lt 2 ] || [ "$NUM" -gt 10 ]; then
    echo "Ошибка: нужно число от 2 до 10."
    exit 1
fi

echo ""
echo "Запуск $NUM терминал(ов) через cmd.exe..."
echo ""

for i in $(seq 1 "$NUM"); do
    MSG="echo ''; echo 'Терминал №$i'; echo ''; echo 'Пользователь: $(whoami)'; echo 'Директория: $(pwd)'; echo 'Дата: $(date)'; echo ''; echo 'Нажми Enter, чтобы закрыть терминал.'; read"
    cmd.exe /c start "Терминал #$i" wsl.exe bash -c "$MSG" 2>/dev/null &

    echo "  → терминал #$i запущен"
done


echo ""
echo "Все $NUM терминал(ов) запущены."
