# Задание 3.4 — интерактивный запуск нескольких «терминалов» (фоновых задач)
# Примечание: в WSL без X-сервера GUI-терминалы не открываются.
# Поэтому «терминалом» здесь считается отдельный фоновый процесс, который пишет в свой лог-файл и выполняет небольшую программу.

echo " запуск нескольких терминалов по количеству голов в команде "
echo ""

read -p "Сколько голов в команде? (2-10): " NUM

if ! [[ "$NUM" =~ ^[0-9]+$ ]] || [ "$NUM" -lt 2 ] || [ "$NUM" -gt 10 ]; then
    echo "Ошибка: нужно число от 2 до 10."
    exit 1
fi

LOGDIR="$HOME/terminals_log"
mkdir -p "$LOGDIR"

echo ""
echo "Логи будут в: $LOGDIR"
echo "Запускаю $NUM терминал(ов)..."
echo ""

for i in $(seq 1 "$NUM"); do
    LOGFILE="$LOGDIR/term_$i.log"
    echo "  → терминал #$i → $LOGFILE"

    (
        echo "=== Терминал #$i ==="
        echo "Пользователь: $(whoami)"
        echo "Директория: $(pwd)"
        echo "Дата: $(date)"
        echo ""
        echo "Небольшая программка: считаю до 5..."
        for n in 1 2 3 4 5; do
            echo "Шаг $n"
            sleep 1
        done
        echo "Готово!"
    ) > "$LOGFILE" 2>&1 &
done
echo ""
echo "Все $NUM терминал(ов) запущены в фоне."
echo "Подожди 6 секунд и посмотри логи:"
echo "    cat $LOGDIR/term_*.log"
