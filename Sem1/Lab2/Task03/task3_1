# Задание 3.1 — интерактивный запуск другого скрипта из текущей директории

echo "Доступные скрипты в текущей директории:"
ls -1 *.sh 2>/dev/null

echo
read -p "Введите имя скрипта для запуска: " script_name

if [ -f "$script_name" ]; then
    echo "Запускаем $script_name ..."
    chmod +x "$script_name"      # на случай, если нет прав на выполнение
    ./"$script_name"
else
    echo "Файл $script_name не найден в текущей директории."
    exit 1
fi
